# Development defaults only. Never commit .env with real credentials.
MYSQL_ROOT_PASSWORD=root_local_dev_only
MYSQL_DATABASE=plan2sim
MYSQL_USER=plan2sim
MYSQL_PASSWORD=dev_change_me
# The frontend runs independently at http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# To run FastAPI outside Docker, set DATABASE_URL manually:
# mysql+pymysql://plan2sim:dev_change_me@127.0.0.1:3307/plan2sim?charset=utf8mb4
# LLM（Google Gemini API）。真正的金鑰只放 .env，不可 commit
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash
# 設定後會把每次 LLM 輸入輸出寫成 JSONL（可能含個資，勿 commit）
LLM_LOG_DIR=
