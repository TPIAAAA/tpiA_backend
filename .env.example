# Development defaults only. Never commit .env with real credentials.
MYSQL_ROOT_PASSWORD=root_local_dev_only
MYSQL_DATABASE=plan2sim
MYSQL_USER=plan2sim
MYSQL_PASSWORD=dev_change_me
# The frontend runs independently at http://localhost:3000
CORS_ORIGINS=http://localhost:3000
